# ============================================
# Logto User Center - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际的配置值
# 注意: .env 文件包含敏感信息,不要提交到 Git

# ============================================
# Logto Management API 配置 (必需)
# ============================================
# Logto Management API 端点
# 示例: https://your-logto.com/api
LOGTO_MANAGEMENT_API_ENDPOINT=https://your-logto.com/api

# Logto Management API 密钥
# 在 Logto 管理后台 -> 设置 -> API 密钥中创建
LOGTO_MANAGEMENT_API_KEY=your-management-api-key-here

# (可选) Logto 应用 ID
# 用于 OIDC 认证
LOGTO_APP_ID=your-app-id

# (可选) Logto 应用密钥
LOGTO_APP_SECRET=your-app-secret

# (可选) OIDC 重定向 URI
LOGTO_REDIRECT_URI=http://localhost:3000/auth/callback

# (可选) Logto 端点
LOGTO_ENDPOINT=https://your-logto.com

# ============================================
# 扩展数据库配置 (必需)
# ============================================
# 数据库类型: mysql 或 postgresql
DATABASE_TYPE=postgresql

# 数据库连接信息
DATABASE_HOST=localhost
DATABASE_PORT=5432  # PostgreSQL 默认 5432, MySQL 默认 3306
DATABASE_USERNAME=logto_manager
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=logto_user_center_dev

# (可选) 数据库 Schema (仅 PostgreSQL)
# DATABASE_SCHEMA=public

# (可选) 启用 SSL 连接
# DATABASE_SSL=false

# (可选) 完整的数据库连接 URL
# 如果设置此项,将忽略上面的单独配置项
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# Redis 配置 (可选)
# ============================================
# 如果不配置 Redis,将使用内存缓存
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================
# JWT 配置 (必需)
# ============================================
# JWT 密钥 (生产环境请使用强密码)
# 建议使用: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# JWT 过期时间
# 格式: Xd (天), Xh (小时), Xm (分钟)
JWT_EXPIRES_IN=7d

# ============================================
# 应用配置 (必需)
# ============================================
# 应用监听端口
APP_PORT=3001

# 应用名称
APP_NAME=Logto User Center

# 运行环境: development, production, test
NODE_ENV=development

# ============================================
# 邮件配置 (可选 - 邀请功能需要)
# ============================================
# 如果不配置邮件,邀请功能将不可用
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your-email@example.com
# MAIL_PASSWORD=your-email-password
# MAIL_FROM=noreply@example.com

# ============================================
# 前端 URL (可选 - 用于 CORS)
# ============================================
# 用于 CORS 配置,允许前端跨域访问
FRONTEND_URL=http://localhost:3000

# ============================================
# 开发提示
# ============================================
# 1. 复制此文件: cp .env.example .env
# 2. 填入实际的配置值
# 3. 确保 .env 在 .gitignore 中,不会被提交
# 4. 生产环境建议使用环境变量或密钥管理系统
